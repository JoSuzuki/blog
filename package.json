{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "semi": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app.css"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@sendgrid/mail": "^8.1.6",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "compression": "^1.8.2",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "feed": "^4.2.2",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "iron-session": "^9.1.0",
    "morgan": "^1.12.1",
    "prism-react-renderer": "^2.4.1",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "srvx": "^1.0.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "github-slugger": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  }
}
