// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    Int                   @id @default(autoincrement())
  name                  String
  email                 String                @unique
  googleId              String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdSantoriniRooms SantoriniRoom[]
  santoriniRoomPlayers  SantoriniRoomPlayer[]

  @@index([email])
}

// A reader's comment on a post. `route` is the post's route (`/posts/<slug>`).
// `faunaId` is the id the comment had in the FaunaDB backup it was imported
// from (null for comments written on the site), so the import can be repeated.
model Comment {
  id        Int      @id @default(autoincrement())
  route     String
  name      String
  comment   String
  createdAt DateTime @default(now())
  faunaId   String?  @unique

  // Listing a post's comments, oldest first.
  @@index([route, createdAt])
}

// One page-view counter per route.
model HitCounter {
  route String @id
  hits  Int    @default(0)
}

// A table of Santorini (the two-player board game under /games). A room is
// WAITING until its two players are in and one of them starts the game.
// `gameState` is the whole game as JSON (the GameState type in
// src/lib/santorini/game.ts); null until the game starts. `updatedAt` doubles
// as the version every move checks, so two requests cannot both write.
model SantoriniRoom {
  id        Int                   @id @default(autoincrement())
  roomCode  String                @unique
  creator   User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId Int
  status    SantoriniRoomStatus   @default(WAITING)
  gameState Json?
  players   SantoriniRoomPlayer[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // The rooms list shows the WAITING ones.
  @@index([status])
}

enum SantoriniRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

// A seat in a room. Its id is the `playerId` used inside the game state.
model SantoriniRoomPlayer {
  id     Int           @id @default(autoincrement())
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  room   SantoriniRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId Int
  winner Boolean       @default(false)

  @@unique([roomId, userId])
  @@index([userId])
}
