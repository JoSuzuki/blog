# Public origin of the site, used for absolute URLs in the feeds.
# Defaults to https://josuzuki.me.
# SITE_URL=https://josuzuki.me

# Postgres. These match docker-compose.yml (`docker compose up -d`, host port
# 5433). Copy this file to `.env` (git-ignored); `npm run dev`, `npm start` and
# the Prisma CLI read it. In production the platform provides the variables.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/blog?schema=public
# Used by `prisma migrate`; bypasses a connection pooler if you use one.
DIRECT_URL=postgres://postgres:postgres@localhost:5433/blog

# Comment notification email (SendGrid). Optional: with no SENDGRID_API_KEY, or
# without both addresses below, no email is sent.
# SENDGRID_API_KEY=
# COMMENT_NOTIFY_TO=you@example.com
# COMMENT_NOTIFY_FROM=blog@example.com

# Comment rate limit per client address (defaults shown).
# COMMENT_RATE_LIMIT_MAX=5
# COMMENT_RATE_LIMIT_WINDOW_SECONDS=600

# Session cookie (iron-session). Required for Google login; without it, or
# with a value shorter than 32 characters, the site runs with everyone logged
# out and logs a warning at startup. In production use the same value as the
# old site so existing sessions stay valid. Generate one with
# `openssl rand -base64 32`.
IRON_SESSION_SECRET=replace-with-a-random-string-of-32-or-more-characters

# Google OAuth client id for "Sign in with Google" (public). Defaults to the
# site's existing client id; set it only to use a different one.
# GOOGLE_CLIENT_ID=
